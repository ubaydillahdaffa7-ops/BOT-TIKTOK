# Local test: leave APP_PUBLIC_URL and PUBLIC_DOMAIN empty; set NODE_ENV=development.
# Public deployment: set both URLs to your real HTTPS domain, then NODE_ENV=production.
APP_PUBLIC_URL=
APP_DATA_DIR=./.data
TIKTOK_BRIDGE_URL=http://tiktok-bridge:8000
# Optional Pollinations secret key (sk_...). Keep it server-side only.
POLLINATIONS_API_KEY=
PUBLIC_DOMAIN=
NODE_ENV=development
PORT=3000
TRUST_PROXY=1
# Generate with: openssl rand -hex 48
SESSION_SECRET=replace-with-at-least-96-hex-characters

# Required for secure first-time admin creation; setup script generates this value.
ADMIN_SETUP_TOKEN=replace-with-a-random-one-time-setup-token
